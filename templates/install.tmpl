{{/* Gitea 146cc3eec57174711eac0e0a0c7b38670c6e3922: templates/install.tmpl. MIT; SVN adaptation, see docs/upstream/reuse-manifest.md. */}}
{{template "base/head" .}}
<main class="auth"><h1 class="ui top attached header center">首次安装</h1><div class="ui attached segment">{{if .Error}}<p class="message error" role="alert">{{.Error}}</p>{{end}}<form class="ui form" method="post" action="/install"><h2>服务与存储</h2><label>站点名称<input name="site_name" value="{{.SiteName}}" required maxlength="80"></label><label>监听地址<input name="listen" value="127.0.0.1:3000" required></label><label>访问地址<input name="origin" value="http://127.0.0.1:3000" required></label><label>SQLite 数据库绝对路径<input name="database" value="{{.Data}}/svnova.db" required></label><label>仓库存储绝对路径<input name="repositories" value="{{.Data}}/repositories" required></label><h2>首个管理员</h2><label>用户名<input name="name" required autocomplete="username"></label><label>密码<input name="password" type="password" minlength="12" required autocomplete="new-password"></label><p class="muted">密码至少12个字符。请在本机完成安装；安装完成后入口自动锁定。监听地址修改在重启后生效。</p><button class="ui primary button" type="submit">安装 SVNova</button></form></div></main>
{{template "base/footer" .}}
