<div data-task-center-active="{{.Active}}"><div class="ui attached table segment table-scroll"><table class="ui very basic unstackable table"><thead><tr><th>编号</th><th>仓库</th><th>类型</th><th>状态</th><th>触发方式</th><th>操作人</th><th>开始时间</th><th>耗时</th><th>结果概要</th><th>操作</th></tr></thead><tbody>{{range .Items}}<tr><td>#{{.ID}}</td><td><a href="{{.OrgURL}}">{{.OrgName}}</a> / <a href="{{.RepoURL}}">{{.RepoName}}</a></td><td>{{.Kind}}</td><td>{{.State}}</td><td>{{.Trigger}}</td><td>{{.Actor}}</td><td>{{.Started}}</td><td>{{.Duration}}</td><td class="task-result-summary">{{.Result}}</td><td><a class="action-icon-button" href="{{.URL}}" title="查看任务记录" aria-label="查看任务记录">{{template "shared/menu_icon" "eye"}}</a></td></tr>{{else}}<tr><td colspan="10">暂无匹配任务</td></tr>{{end}}</tbody></table></div>{{template "shared/pagination" .Pagination}}</div>
