{{/* Adapted from Gitea templates/repo/view_content.tmpl (MIT), fixed baseline; see reuse manifest. */}}
{{if eq .Tab "settings"}}{{template "repo/settings/options" .}}{{else if eq .Tab "tasks"}}{{if .MigrationPanel}}{{template "repo/migrate/migrating" .}}{{else}}{{template "repo/tasks" .}}{{end}}{{else}}<form method="get" class="toolbar"><input type="hidden" name="tab" value="{{.Tab}}"><input type="hidden" name="path" value="{{.Path}}"><label>修订<input name="revision" type="number" min="0" max="{{.Repo.Revision}}" value="{{.Revision}}"></label><button class="ui button">查看</button>{{template "repo/breadcrumb" .}}</form>
{{if eq .Tab "tree"}}<div class="table-scroll"><table class="ui unstackable table"><thead><tr><th>名称</th><th>修订</th><th>作者</th><th>大小</th></tr></thead><tbody>{{range .Entries}}<tr><td><a href="{{$.EntryLink .}}"><svg class="svg" width="16" height="16" aria-hidden="true"><use href="/assets/img/octicons.svg#{{if eq .Kind "dir"}}file-directory-fill{{else}}file{{end}}"></use></svg> {{.Name}}</a></td><td>r{{.Commit.Revision}}</td><td>{{.Commit.Author}}</td><td>{{if eq .Kind "file"}}<span title="{{.Size}} 字节">{{fileSize .Size}}</span>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="4">目录为空</td></tr>{{end}}</tbody></table></div>{{else if eq .Tab "log"}}{{template "repo/history" .}}{{template "repo/history_pagination" .}}{{else}}{{if eq .Tab "file"}}<a class="ui button" href="/api/v1/repositories/{{.Repo.ID}}/download?path={{.Path}}&amp;revision={{.Revision}}">下载文件</a>{{end}}<pre class="code-view" tabindex="0">{{.Content}}</pre>{{end}}{{end}}
