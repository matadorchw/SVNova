{{if not .SelectedTask}}
<div data-repository-history data-url="/api/v1/repositories/{{.Repo.ID}}/tasks/history" data-retry-url="{{repoLink .Repo.Organization .Repo.Name .Repo.ID}}/settings/migrate/retry"><p data-task-status role="status">正在加载任务记录…</p></div>
{{else}}
{{/* SVN task history using the same authenticated JSON status checker. */}}
{{if .SelectedTask}}<p><a class="ui button" href="{{.Link "tasks" "" .Revision}}">全部仓库任务</a><a class="ui button" href="/tasks">任务中心</a></p>{{end}}
<div class="table-scroll" {{if not .SelectedTask}}data-task-status{{end}} data-status-url="{{repoLink .Repo.Organization .Repo.Name .Repo.ID}}/-/migrate/status" data-repository-state="{{.Migration.RepositoryState}}" data-retry-url="{{repoLink .Repo.Organization .Repo.Name .Repo.ID}}/settings/migrate/retry">
 <table class="ui unstackable table"><thead><tr><th>编号</th><th>任务类型</th><th>状态</th><th>阶段</th><th>开始时间</th><th>结束时间</th><th>结果</th><th>操作</th></tr></thead><tbody>{{range .Migration.Tasks}}<tr><td>#{{.ID}}</td><td>{{.Kind}}</td><td>{{.State}}</td><td>{{.Phase}}{{if .Indeterminate}}<progress aria-label="任务进行中"></progress>{{end}}</td><td>{{.Started}}</td><td>{{.Finished}}</td><td>{{.Message}}</td><td>{{if .Retry}}<form class="ui form" data-api="{{repoLink $.Repo.Organization $.Repo.Name $.Repo.ID}}/settings/migrate/retry"><button class="action-icon-button" title="重试任务" aria-label="重试任务">{{template "shared/menu_icon" "issue-reopened"}}</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="8">暂无任务</td></tr>{{end}}</tbody></table>
 <p class="muted" data-task-connection role="status" hidden>状态暂不可用，正在重试…</p>
</div>

{{end}}
