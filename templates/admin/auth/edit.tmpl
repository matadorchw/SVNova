{{/* Adapted from Gitea templates/admin/auth/edit.tmpl (MIT), LDAP-only form. */}}
<div class="ui top attached header auth-list-header"><h4 class="ldap-config-title">LDAP 配置</h4><div class="auth-history-toolbar"><form class="ui form" data-api="/api/v1/admin/ldap/sync"><button class="ui basic button action-text-button action-small" data-sync-action aria-label="同步用户" title="{{if not .LDAP.Enabled}}请先启用 LDAP 认证并保存{{else if not .LDAP.SyncEnabled}}请先启用用户同步并保存{{else}}同步用户{{end}}" {{if or (not .LDAP.Enabled) (not .LDAP.SyncEnabled)}}disabled{{end}}>{{template "shared/menu_icon" "sync"}}<span>同步用户</span></button></form><a class="ui button action-small" href="/-/admin/ldap/sync-history">同步历史</a></div></div>
<div class="ui attached segment">{{if not .LDAP.Enabled}}<p class="help restriction-hint">{{template "shared/menu_icon" "info"}}请先启用 LDAP 认证并保存，才能同步用户。</p>{{else if not .LDAP.SyncEnabled}}<p class="help restriction-hint">{{template "shared/menu_icon" "info"}}请先启用用户同步并保存，才能同步用户。</p>{{end}}<form class="ui form" data-ldap-config data-api="/api/v1/admin/ldap" data-next="/-/admin/ldap">{{template "admin/auth/source/ldap" .}}<button class="ui primary button">保存 LDAP 配置</button></form></div>
{{template "admin/auth/schedule" .}}
<h4 class="ui top attached header">用户同步</h4><div class="ui attached segment"><p>最近同步：{{.Time .LDAP.LastSync}}</p>{{$report := .LDAPSyncReport}}
{{if .LDAP.LastSyncReport}}<p>本次查询 {{$report.MatchedUsers}} 个用户，已同步 {{$report.SyncedUsers}} 个，停用 {{$report.DeactivatedUsers}} 个。</p>{{end}}
{{if $report.SkippedLocalCount}}<div class="ui warning message" role="status">已跳过 {{$report.SkippedLocalCount}} 个同名本地账号：{{range $report.SkippedLocalUsers}}<code>{{.}}</code> {{end}}。本地账号、密码和权限保持不变。{{if gt $report.SkippedLocalCount (len $report.SkippedLocalUsers)}}仅展示前20个账号。{{end}}</div>{{end}}
{{if .LDAP.LastError}}<p class="danger">最近同步失败，请检查 LDAP 网络、服务账号及搜索配置。</p>{{end}}</div>
