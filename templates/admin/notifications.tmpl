{{/* Gitea admin attached panels and webhook settings conventions (MIT), adapted for one global SVN/LDAP robot. */}}
<div class="admin-setting-content">
{{if eq .Notifications.View "deliveries"}}
<h4 class="ui top attached header auth-list-header"><span data-notification-total>通知投递记录（{{.Notifications.Total}}）</span><div class="auth-history-toolbar"><a class="action-icon-button" data-refresh-action href="{{.Notifications.Link .Notifications.Page}}" aria-label="刷新投递记录" title="刷新投递记录">{{template "shared/menu_icon" "sync"}}</a><a class="ui button action-small" href="/-/admin/notifications">返回配置</a></div></h4>
{{template "admin/notification_search" .}}
<div id="notification-records">
<div class="ui attached table segment table-scroll"><table class="ui very basic table unstackable notification-table"><thead><tr><th{{if eq .Notifications.Sort "oldest"}} aria-sort="ascending"{{else if eq .Notifications.Sort "newest"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .Notifications.Sort "oldest"}}{{.Notifications.SortLink "newest"}}{{else}}{{.Notifications.SortLink "oldest"}}{{end}}" title="切换ID排序">ID{{if eq .Notifications.Sort "oldest"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .Notifications.Sort "newest"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th>类型</th><th>对象</th><th>状态</th><th{{if eq .Notifications.Sort "attempts"}} aria-sort="ascending"{{else if eq .Notifications.Sort "attempts-desc"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .Notifications.Sort "attempts"}}{{.Notifications.SortLink "attempts-desc"}}{{else}}{{.Notifications.SortLink "attempts"}}{{end}}" title="切换尝试次数排序">尝试次数{{if eq .Notifications.Sort "attempts"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .Notifications.Sort "attempts-desc"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th{{if eq .Notifications.Sort "created"}} aria-sort="ascending"{{else if eq .Notifications.Sort "created-desc"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .Notifications.Sort "created"}}{{.Notifications.SortLink "created-desc"}}{{else}}{{.Notifications.SortLink "created"}}{{end}}" title="切换创建时间排序">创建时间{{if eq .Notifications.Sort "created"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .Notifications.Sort "created-desc"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th{{if eq .Notifications.Sort "next"}} aria-sort="ascending"{{else if eq .Notifications.Sort "next-desc"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .Notifications.Sort "next"}}{{.Notifications.SortLink "next-desc"}}{{else}}{{.Notifications.SortLink "next"}}{{end}}" title="切换下次尝试排序">下次尝试{{if eq .Notifications.Sort "next"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .Notifications.Sort "next-desc"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th{{if eq .Notifications.Sort "finished"}} aria-sort="ascending"{{else if eq .Notifications.Sort "finished-desc"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .Notifications.Sort "finished"}}{{.Notifications.SortLink "finished-desc"}}{{else}}{{.Notifications.SortLink "finished"}}{{end}}" title="切换完成时间排序">完成时间{{if eq .Notifications.Sort "finished"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .Notifications.Sort "finished-desc"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th>说明</th><th>操作</th></tr></thead><tbody>{{range .Notifications.Deliveries}}<tr><td><a href="/-/admin/notifications?tab=deliveries&amp;delivery={{.ID}}">#{{.ID}}</a>{{if .ParentID}}<small>重发自 #{{.ParentID}}</small>{{end}}</td><td>{{$.NotificationKind .Kind}}</td><td>{{.Object}}</td><td>{{$.NotificationState .Status}}</td><td>{{.Attempts}} / 4</td><td>{{$.NotificationTime .Created}}</td><td>{{if or (eq .Status "retry") (eq .Status "pending")}}{{$.NotificationTime .NextAttempt}}{{else}}—{{end}}</td><td>{{$.NotificationTime .Finished}}</td><td>{{.LastError}}</td><td class="notification-actions"><a class="action-icon-button" href="/-/admin/notifications?tab=deliveries&amp;delivery={{.ID}}" title="查看投递详情" aria-label="查看投递详情">{{template "shared/menu_icon" "eye"}}</a>{{if eq .Status "failed"}}<form class="ui form" data-notification-confirm="将向当前机器人重新发送这条消息，可能产生重复通知。确定继续？" data-api="/api/v1/admin/notifications/deliveries/{{.ID}}/redeliver" data-next="/-/admin/notifications?tab=deliveries"><button class="action-icon-button" aria-label="重发到当前机器人" title="重发到当前机器人">{{template "shared/menu_icon" "paper-airplane"}}</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="10">暂无投递记录。启用前的同步不补发。</td></tr>{{end}}</tbody></table></div>
{{template "shared/pagination" .Notifications.Pagination}}
{{with .Notifications.Detail}}<h4 class="ui top attached header">投递 #{{.ID}} · {{$.NotificationState .Status}}</h4><div class="ui attached segment"><p>事件编号：<code>{{.EventKey}}</code>。重发使用当前机器人；超时可能已送达，请先检查群消息。</p><h5>消息预览</h5><pre class="notification-preview">{{$.Notifications.Preview}}</pre><h5>尝试记录</h5><div class="table-scroll"><table class="ui unstackable table notification-table"><thead><tr><th>次数</th><th>开始</th><th>完成</th><th>结果</th><th>说明</th></tr></thead><tbody>{{range $.Notifications.Attempts}}<tr><td>{{.Number}}</td><td>{{$.NotificationTime .Started}}</td><td>{{$.NotificationTime .Finished}}</td><td>{{$.NotificationState .Status}}</td><td>{{.Reason}}</td></tr>{{else}}<tr><td colspan="5">尚未尝试发送。</td></tr>{{end}}</tbody></table></div></div>{{end}}
</div>
{{else}}
<h4 class="ui top attached header auth-list-header"><span>钉钉通知配置</span><a class="ui button action-small" href="/-/admin/notifications?tab=deliveries">查看投递记录</a></h4><div class="ui attached segment"><p>全站使用一个加签机器人，仅管理员可配置。保存不会发送消息；建议先发送测试消息，再手动开启。</p>
<form class="ui form" data-notification-settings data-api="/api/v1/admin/notifications" data-next="/-/admin/notifications">
<div class="field"><label class="check"><input type="checkbox" name="Enabled" {{if .Notifications.Config.Enabled}}checked{{end}}>启用全站通知</label></div>
<div class="field"><label class="check"><input type="checkbox" name="ReplaceWebhook" data-notification-credential="notification-webhook">设置／替换 Webhook 地址</label><input id="notification-webhook" type="password" name="Webhook" autocomplete="new-password" disabled maxlength="4096" aria-label="钉钉 Webhook 地址"><p class="help">仅支持 https://oapi.dingtalk.com/robot/send?access_token=…，保存后不回显。</p></div>
<div class="field"><label class="check"><input type="checkbox" name="ReplaceSecret" data-notification-credential="notification-secret">设置／替换签名密钥</label><input id="notification-secret" type="password" name="Secret" autocomplete="new-password" disabled maxlength="1024" aria-label="钉钉签名密钥"><p class="help">Webhook 和签名密钥均必填。{{if .Notifications.Configured}}当前凭据已配置。{{else}}当前凭据尚未完整配置。{{end}}</p></div>
<div class="field"><label class="check"><input type="checkbox" name="SVNEnabled" {{if .Notifications.Config.SVNEnabled}}checked{{end}}>SVN 同步结果通知</label><p class="help">首次镜像迁移、手动和自动同步结束；失败或成功有新增修订时通知。</p></div><div class="field"><label class="check"><input type="checkbox" name="SVNFailureOnly" {{if .Notifications.Config.SVNFailureOnly}}checked{{end}}>SVN 仅通知失败</label><p class="help">开启后不发送任何 SVN 成功通知，优先于“无新增修订也通知”；已排队的成功消息会取消。</p></div><div class="field"><label class="check"><input type="checkbox" name="SVNNoChange" {{if .Notifications.Config.SVNNoChange}}checked{{end}}>SVN 无新增修订也通知</label></div>
<div class="field"><label class="check"><input type="checkbox" name="LDAPEnabled" {{if .Notifications.Config.LDAPEnabled}}checked{{end}}>LDAP 同步结果通知</label><p class="help">手动和定时同步结束；失败或用户实际新增、资料更新、启停变化时通知，不包含登录和用户明细。</p></div><div class="field"><label class="check"><input type="checkbox" name="LDAPNoChange" {{if .Notifications.Config.LDAPNoChange}}checked{{end}}>LDAP 无实际变化也通知</label></div>
<div class="field"><label for="notification-retention">投递记录保留期限</label><select id="notification-retention" name="RetentionDays" data-number><option value="30" {{if eq .Notifications.Config.RetentionDays 30}}selected{{end}}>30 天</option><option value="90" {{if eq .Notifications.Config.RetentionDays 90}}selected{{end}}>90 天</option><option value="180" {{if eq .Notifications.Config.RetentionDays 180}}selected{{end}}>180 天</option><option value="0" {{if eq .Notifications.Config.RetentionDays 0}}selected{{end}}>永久保留</option></select><p class="help">仅清理已结束的投递记录，不影响同步历史和待处理消息。</p></div>
<p class="help">关闭通知或关闭分类会取消相关待发送消息；更换机器人凭据取消旧目标待发送消息。历史保留，重新开启不补发。已发出的请求无法撤回。</p><button class="ui primary button">保存通知设置</button></form></div>
<h4 class="ui top attached header">测试机器人</h4><div class="ui attached segment"><p>使用已保存配置发送一条测试消息，不受总开关控制；请先保存修改。</p>{{if not .Notifications.Configured}}<p class="help restriction-hint">{{template "shared/menu_icon" "info"}}请先保存有效的机器人配置，再发送测试消息。</p>{{end}}<form class="ui form" data-api="/api/v1/admin/notifications/test" data-next="/-/admin/notifications?tab=deliveries" data-notification-confirm="将使用已保存配置向钉钉群发送测试消息。确定发送？"><button class="ui button" {{if not .Notifications.Configured}}disabled{{end}}>{{template "shared/menu_icon" "bell"}} 发送测试消息</button></form></div>
{{end}}</div>
