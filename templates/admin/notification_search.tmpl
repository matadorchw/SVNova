{{/* Adapted from the pinned Gitea admin/user search and filter menus (MIT). */}}
<div class="ui attached segment"><form id="notification-list-search-form" class="ui form admin-users-filters" method="get" action="/-/admin/notifications">
<input type="hidden" name="tab" value="deliveries"><input type="hidden" name="sort" value="{{.Notifications.Sort}}">
<div class="ui action input admin-users-search"><span class="ui input search-clear-field" data-search-clear="submit"><input name="q" value="{{.Notifications.Keyword}}" placeholder="搜索投递记录…" aria-label="搜索编号、对象或失败原因">{{template "shared/search_clear" .}}</span><button class="ui icon button" aria-label="搜索">{{template "shared/menu_icon" "search"}}</button></div>
<div class="ui secondary menu admin-users-menus">
<div class="ui dropdown item" data-menu-dropdown tabindex="0" aria-label="过滤投递记录"><span class="text">过滤{{if or .Notifications.Kind .Notifications.Status}} <span class="filter-indicator" aria-label="已应用过滤条件"></span>{{end}}</span>{{template "shared/menu_icon" "triangle-down"}}
<div class="menu"><button type="button" class="item" data-user-filter-reset>重置过滤条件</button><div class="divider"></div>
<label class="item"><input type="radio" name="kind" value="svn" {{if eq .Notifications.Kind "svn"}}checked{{end}}>SVN同步</label>
<label class="item"><input type="radio" name="kind" value="ldap" {{if eq .Notifications.Kind "ldap"}}checked{{end}}>LDAP同步</label>
<label class="item"><input type="radio" name="kind" value="test" {{if eq .Notifications.Kind "test"}}checked{{end}}>测试消息</label><div class="divider"></div>
<label class="item"><input type="radio" name="status" value="pending" {{if eq .Notifications.Status "pending"}}checked{{end}}>待发送</label>
<label class="item"><input type="radio" name="status" value="sending" {{if eq .Notifications.Status "sending"}}checked{{end}}>发送中</label>
<label class="item"><input type="radio" name="status" value="retry" {{if eq .Notifications.Status "retry"}}checked{{end}}>等待重试</label>
<label class="item"><input type="radio" name="status" value="success" {{if eq .Notifications.Status "success"}}checked{{end}}>成功</label>
<label class="item"><input type="radio" name="status" value="failed" {{if eq .Notifications.Status "failed"}}checked{{end}}>失败</label>
<label class="item"><input type="radio" name="status" value="cancelled" {{if eq .Notifications.Status "cancelled"}}checked{{end}}>已取消</label>
</div></div>
<div class="ui dropdown item admin-users-sort-menu org-sort-menu" data-menu-dropdown tabindex="0" aria-label="排序投递记录"><span class="text">排序</span>{{template "shared/menu_icon" "triangle-down"}}<div class="menu"><button type="button" class="item{{if eq .Notifications.Sort "newest"}} active{{end}}" data-user-sort="newest">最新创建</button><button type="button" class="item{{if eq .Notifications.Sort "oldest"}} active{{end}}" data-user-sort="oldest">最早创建</button><button type="button" class="item{{if eq .Notifications.Sort "attempts"}} active{{end}}" data-user-sort="attempts">尝试次数升序</button><button type="button" class="item{{if eq .Notifications.Sort "attempts-desc"}} active{{end}}" data-user-sort="attempts-desc">尝试次数降序</button><button type="button" class="item{{if eq .Notifications.Sort "created"}} active{{end}}" data-user-sort="created">创建时间升序</button><button type="button" class="item{{if eq .Notifications.Sort "created-desc"}} active{{end}}" data-user-sort="created-desc">创建时间降序</button><button type="button" class="item{{if eq .Notifications.Sort "next"}} active{{end}}" data-user-sort="next">下次尝试升序</button><button type="button" class="item{{if eq .Notifications.Sort "next-desc"}} active{{end}}" data-user-sort="next-desc">下次尝试降序</button><button type="button" class="item{{if eq .Notifications.Sort "finished"}} active{{end}}" data-user-sort="finished">完成时间升序</button><button type="button" class="item{{if eq .Notifications.Sort "finished-desc"}} active{{end}}" data-user-sort="finished-desc">完成时间降序</button></div></div>
</div></form></div>
