{{/* Adapted from Gitea templates/admin/user/list.tmpl (MIT), pinned baseline; SVN account capabilities only. */}}
<div class="admin-setting-content">
<h4 class="ui top attached header admin-users-heading"><span>用户账户管理（总计：{{.AdminUsers.Total}}）</span><a class="ui primary button action-small" href="/-/admin/users/new">创建新账户</a></h4>
{{template "admin/user/search" .}}
<div class="ui attached table segment table-scroll"><table class="ui very basic selectable table unstackable admin-users-table"><thead><tr><th{{if eq .AdminUsers.Sort "oldest"}} aria-sort="ascending"{{else if eq .AdminUsers.Sort "newest"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .AdminUsers.Sort "oldest"}}{{.AdminUsers.SortLink "newest"}}{{else}}{{.AdminUsers.SortLink "oldest"}}{{end}}" title="切换ID排序">ID{{if eq .AdminUsers.Sort "oldest"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .AdminUsers.Sort "newest"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th{{if eq .AdminUsers.Sort "alphabetically"}} aria-sort="ascending"{{else if eq .AdminUsers.Sort "reversealphabetically"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .AdminUsers.Sort "alphabetically"}}{{.AdminUsers.SortLink "reversealphabetically"}}{{else}}{{.AdminUsers.SortLink "alphabetically"}}{{end}}" title="切换用户名排序">用户名{{if eq .AdminUsers.Sort "alphabetically"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .AdminUsers.Sort "reversealphabetically"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th>电子邮箱</th><th>启用</th><th>认证来源</th><th{{if eq .AdminUsers.Sort "created"}} aria-sort="ascending"{{else if eq .AdminUsers.Sort "created-desc"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .AdminUsers.Sort "created"}}{{.AdminUsers.SortLink "created-desc"}}{{else}}{{.AdminUsers.SortLink "created"}}{{end}}" title="切换创建时间排序">创建时间{{if eq .AdminUsers.Sort "created"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .AdminUsers.Sort "created-desc"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th{{if eq .AdminUsers.Sort "reverselastlogin"}} aria-sort="ascending"{{else if eq .AdminUsers.Sort "lastlogin"}} aria-sort="descending"{{end}}><a class="org-sort-heading" href="{{if eq .AdminUsers.Sort "reverselastlogin"}}{{.AdminUsers.SortLink "lastlogin"}}{{else}}{{.AdminUsers.SortLink "reverselastlogin"}}{{end}}" title="切换最后登录排序">最后登录{{if eq .AdminUsers.Sort "reverselastlogin"}} {{template "shared/menu_icon" "triangle-up"}}{{else if eq .AdminUsers.Sort "lastlogin"}} {{template "shared/menu_icon" "triangle-down"}}{{end}}</a></th><th>操作</th></tr></thead><tbody>
{{range .AdminUsers.Items}}<tr><td>{{.ID}}</td><td><a href="/user/profile?user_id={{.ID}}">{{.Name}}</a>{{if .Admin}} <span class="ui mini label">管理员</span>{{end}}</td><td class="admin-user-email" title="{{.Email}}">{{if .Email}}{{.Email}}{{else}}—{{end}}</td><td><span role="img" aria-label="{{if .Active}}已启用{{else}}已停用{{end}}">{{if .Active}}{{template "shared/menu_icon" "check"}}{{else}}{{template "shared/menu_icon" "x"}}{{end}}</span></td><td>{{if .LDAPAccount}}LDAP{{else}}本地{{end}}</td><td>{{$.UserTime .Created}}</td><td>{{$.UserTime .LastLogin}}</td><td><div class="admin-user-actions"><a class="admin-user-edit" href="/-/admin/users/{{.ID}}" title="查看用户详情" aria-label="查看用户详情">{{template "shared/menu_icon" "person"}}</a><a class="admin-user-edit" href="/-/admin/users/{{.ID}}/edit" title="编辑用户" aria-label="编辑用户">{{template "shared/menu_icon" "pencil"}}</a></div></td></tr>{{else}}<tr><td colspan="8" class="empty">没有匹配的用户。</td></tr>{{end}}
</tbody></table></div>
{{template "admin/user/paginate" .}}</div>
