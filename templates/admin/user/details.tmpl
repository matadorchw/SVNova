{{/* Adapted from Gitea admin/user/view.tmpl, view_details.tmpl and view_emails.tmpl (MIT). */}}
<div class="admin-setting-content admin-user-details">
<div class="admin-user-detail-columns">
<section><h4 class="ui top attached header admin-users-heading"><span>用户详细信息</span><a class="ui primary button action-small" href="/-/admin/users/{{.EditUser.ID}}/edit">修改</a></h4><div class="ui attached segment"><div class="admin-user-detail-identity"><img loading="lazy" src="/avatars/users/{{.EditUser.ID}}?size=96" width="48" height="48" alt="用户头像"><div class="admin-user-detail-info"><div><a class="admin-user-detail-name" href="/user/profile?user_id={{.EditUser.ID}}">{{.EditUser.Name}}{{if .EditUser.DisplayName}}（{{.EditUser.DisplayName}}）{{end}}</a>{{if .EditUser.Admin}} <span class="ui basic label">管理员</span>{{end}}</div><div><b>认证来源：</b>{{.UserAuthSource}}</div><div><b>已启用：</b><span role="img" aria-label="{{if .EditUser.Active}}是{{else}}否{{end}}">{{if .EditUser.Active}}{{template "shared/menu_icon" "check"}}{{else}}{{template "shared/menu_icon" "x"}}{{end}}</span></div><div><b>目录停用：</b><span role="img" aria-label="{{if .EditUser.LDAPDisabled}}是{{else}}否{{end}}">{{if .EditUser.LDAPDisabled}}{{template "shared/menu_icon" "check"}}{{else}}{{template "shared/menu_icon" "x"}}{{end}}</span></div><div><b>创建时间：</b>{{.UserTime .EditUser.Created}}</div><div><b>最后登录：</b>{{.UserTime .EditUser.LastLogin}}</div></div></div></div></section>
<section><h4 class="ui top attached header">用户邮箱（总计：{{if .EditUser.Email}}1{{else}}0{{end}}）</h4><div class="ui attached segment">{{if .EditUser.Email}}<div class="admin-user-detail-email"><a href="mailto:{{.EditUser.Email}}">{{.EditUser.Email}}</a><span class="ui primary label">主</span></div>{{else}}未设置邮箱{{end}}</div></section>
</div>
<section><h4 class="ui top attached header">可访问仓库（总计：{{.RepositoryPagination.Total}}）</h4><div class="ui attached segment admin-user-detail-list">{{range .Repositories}}<div class="repo-list-entry"><a href="{{repoLink .Organization .Name .ID}}">{{template "shared/menu_icon" "repo"}} {{.Organization}}/{{.Name}} {{template "repo/size" .Repository}}</a>{{template "repo/list_remote" .Repository}}</div>{{else}}未找到匹配结果{{end}}</div>{{template "shared/pagination" .RepositoryPagination}}</section>
<section><h4 class="ui top attached header">组织（总计：{{len .Organizations}}）</h4><div class="ui attached segment admin-user-detail-list">{{range .Organizations}}<a href="{{orgLink .Name}}">{{template "shared/menu_icon" "organization"}} {{.Name}}</a>{{else}}未找到匹配结果{{end}}</div></section>
</div>
