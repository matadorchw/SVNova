{{/* Adapted from Gitea templates/org/header.tmpl (MIT). */}}
<div class="org-profile-header flex-container">
 <img loading="lazy" class="org-avatar" src="/avatars/organizations/{{.Org.ID}}?size=200" width="100" height="100" alt="">
 <div class="flex-container-main"><h1>{{.Org.DisplayName}} <span class="ui basic label">私有</span></h1>{{if .Org.Description}}<p class="org-description">{{.Org.Description}}</p>{{end}}<div class="org-contact">{{if .Org.Location}}<span>{{.Org.Location}}</span>{{end}}{{if .Org.Website}}<a href="{{.Org.Website}}">{{.Org.Website}}</a>{{end}}{{if .Org.Email}}<a href="mailto:{{.Org.Email}}">{{.Org.Email}}</a>{{end}}</div></div>
</div>
{{template "org/menu" .}}
