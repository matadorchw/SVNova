{{/* Adapted from Gitea templates/org/member/members.tmpl (MIT). */}}
<div class="org-management-toolbar"><p>成员通过团队进行管理。将用户添加到团队，即可将其加入此组织。</p>{{if .Org.CanManage}}<a class="ui primary button" href="{{.OrgSection "teams"}}">管理团队和成员</a>{{end}}</div>
<form class="ui form org-search" method="get"><div class="ui fluid action input"><span class="ui input search-clear-field" data-search-clear="submit"><input type="search" name="q" value="{{.Search}}" placeholder="搜索用户…" aria-label="搜索用户">{{template "shared/search_clear" .}}</span><button class="ui icon button" aria-label="搜索">{{template "shared/menu_icon" "search"}}</button></div></form>
<div class="org-members-list">
 {{range .FilteredMembers}}<div class="org-member-item">{{if $.CanViewUserProfile .UserID}}<a href="/user/profile?user_id={{.UserID}}"><img loading="lazy" class="avatar" src="/avatars/users/{{.UserID}}?org={{$.Org.ID}}&amp;size=96" width="48" height="48" alt=""></a>{{else}}<img loading="lazy" class="avatar" src="/avatars/users/{{.UserID}}?org={{$.Org.ID}}&amp;size=96" width="48" height="48" alt="">{{end}}<div class="org-member-main"><strong>{{if $.CanViewUserProfile .UserID}}<a href="/user/profile?user_id={{.UserID}}">{{$.Username .UserID}}</a>{{else}}{{$.Username .UserID}}{{end}}{{with $.UserDisplayName .UserID}}（{{.}}）{{end}}</strong> <p>成员角色：{{if $.IsOrgOwner .UserID}}{{template "shared/menu_icon" "shield"}}<strong>管理员（Owners）</strong>{{else}}普通成员{{end}}</p></div>{{if $.Org.CanManage}}<form class="ui form" data-member-remove="确认将 {{$.Username .UserID}} 从组织 {{$.Org.Name}} 移除？该用户将失去此组织的团队成员关系和访问权限。" data-api="/api/v1/organizations/{{$.Org.ID}}/members"><input type="hidden" name="UserID" data-number value="{{.UserID}}"><input type="hidden" name="Remove" data-bool value="true"><button class="ui basic red button action-small" {{if not ($.CanRemoveOrgMember .UserID)}}disabled title="至少保留一位 Owners 成员"{{end}}>移除成员</button></form>{{end}}{{if and $.Org.CanManage (not ($.CanRemoveOrgMember .UserID))}}<p class="help restriction-hint org-member-restriction">{{template "shared/menu_icon" "info"}}此成员是 Owners 的最后一位成员，不能移除。</p>{{end}}</div>{{else}}<p class="empty">没有匹配的成员。</p>{{end}}
</div>

{{template "shared/pagination" .MemberPagination}}
