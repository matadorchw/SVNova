{{/* Adapted from Gitea templates/org/team/repositories.tmpl (MIT). */}}
<div class="team-detail-layout">{{template "org/team/sidebar" .}}<section class="team-detail-main team-repositories-page">
{{template "org/team/navbar" .}}
{{if .Team.IsOwnerTeam}}<div class="ui segment restriction-hint">{{template "shared/menu_icon" "info"}}Owners 自动管理组织的全部仓库。</div>{{else if .Org.CanManage}}<div class="ui segment"><form class="ui form team-add-repository" data-api="/api/v1/teams/{{.Team.ID}}/repositories"><select name="RepositoryID" data-number aria-label="选择仓库" required><option value="" selected disabled>选择仓库</option>{{range .AvailableTeamRepositories}}<option value="{{.ID}}">{{.Organization}}/{{.Name}}</option>{{end}}</select><button class="ui primary button">添加仓库</button></form></div>{{end}}
<form class="ui form team-repository-search" method="get"><div class="ui fluid action input"><span class="ui input search-clear-field" data-search-clear="submit"><input type="search" name="q" value="{{.Search}}" placeholder="搜索仓库…" aria-label="搜索仓库">{{template "shared/search_clear" .}}</span><button class="ui icon button" aria-label="搜索">{{template "shared/menu_icon" "search"}}</button></div></form>
<div class="ui segment team-repository-list">{{range .FilteredTeamRepositories}}<div class="team-repository-row"><span class="team-repository-icon">{{if eq .Kind "mirror"}}{{template "shared/menu_icon" "mirror"}}{{else}}{{template "shared/menu_icon" "repo"}}{{end}}</span><div class="team-repository-info"><a href="{{repoLink .Organization .Name .ID}}">{{.Organization}}/{{.Name}}</a><div class="muted">{{if eq .Kind "mirror"}}镜像仓库{{else}}本地仓库{{end}} · {{if .Halted}}已停止{{else if eq .Status "ready"}}就绪{{else if eq .Status "failed"}}失败{{else}}处理中{{end}} · {{template "repo/size" .Repository}}{{if .LastSuccess}} · 最近成功：{{$.Time .LastSuccess}}{{end}}</div>{{template "repo/list_remote" .Repository}}</div>{{if and $.Org.CanManage (not $.Team.IsOwnerTeam)}}<form data-api="/api/v1/teams/{{$.Team.ID}}/repositories"><input type="hidden" name="RepositoryID" data-number value="{{.ID}}"><input type="hidden" name="Remove" data-bool value="true"><button class="ui basic red button action-small">移除仓库</button></form>{{end}}</div>{{else}}<p class="muted">没有匹配的仓库。</p>{{end}}</div>
{{template "shared/pagination" .RepositoryPagination}}</section></div>
