{{/* Adapted from Gitea templates/org/team/teams.tmpl (MIT). */}}
{{if .NewTeam}}{{template "org/team/new" .}}{{else if .Team}}{{if eq .TeamView "repositories"}}{{template "org/team/repositories" .}}{{else}}{{template "org/team/members" .}}{{end}}{{else}}
<div class="org-management-toolbar"><p>成员通过团队进行管理。将用户添加到团队，即可将其加入此组织。</p>{{if .Org.CanManage}}<a class="ui primary button" href="{{.OrgSection "teams"}}/new">新建团队</a>{{end}}</div>
<form class="ui form org-search" method="get"><div class="ui fluid action input"><span class="ui input search-clear-field" data-search-clear="submit"><input type="search" name="q" value="{{.Search}}" placeholder="搜索团队…" aria-label="搜索团队">{{template "shared/search_clear" .}}</span><button class="ui icon button" aria-label="搜索">{{template "shared/menu_icon" "search"}}</button></div></form>
<div class="org-team-cards">
 {{range .FilteredTeams}}{{$team := .}}<section class="team-item-box"><div class="ui top attached header team-item-header"><div><a href="{{teamLink $.Org.Name .Name .ID}}"><strong>{{.Name}}</strong></a> <span class="ui mini label">{{if .IsOwnerTeam}}内置{{else}}组织内{{end}}</span></div><div class="team-card-actions"><a href="{{teamLink $.Org.Name .Name .ID}}">{{.MemberCount}} 名成员</a> · <a href="{{teamRepositoriesLink $.Org.Name .Name .ID}}">{{.RepoCount}} 个仓库</a>{{if .IsMember}}<form data-team-leave="确认离开团队 {{.Name}}？离开最后一个团队时也会离开组织。" data-api="/api/v1/teams/{{.ID}}/leave" data-next="/"><button class="ui basic red button action-small" {{if not .CanLeave}}disabled title="至少保留一位 Owners 成员"{{end}}>离开团队</button></form>{{end}}</div></div>{{if .Description}}<div class="ui attached header team-item-description">{{.Description}}</div>{{end}}<div class="ui attached segment team-card-content"><div class="team-card-avatars">{{range .Members}}<a href="{{teamLink $.Org.Name $team.Name $team.ID}}" class="team-avatar-link" title="{{$.Username .UserID}}"><img loading="lazy" class="avatar" src="/avatars/users/{{.UserID}}?org={{$.Org.ID}}&amp;size=64" width="32" height="32" alt="{{$.Username .UserID}}"></a>{{else}}<a href="{{teamLink $.Org.Name .Name .ID}}">添加团队成员</a>{{end}}</div>{{if and .IsMember (not .CanLeave)}}<p class="help restriction-hint">{{template "shared/menu_icon" "info"}}你是 Owners 的最后一位成员，不能离开团队。</p>{{end}}</div></section>{{else}}<p class="empty">没有匹配的团队。</p>{{end}}
</div>{{end}}
