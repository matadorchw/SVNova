{{/* Adapted from Gitea templates/org/team/members.tmpl (MIT). */}}
<div class="team-detail-layout">{{template "org/team/sidebar" .}}<section class="team-detail-main">{{template "org/team/navbar" .}}
 {{if .Org.CanManage}}<div class="ui segment"><form class="ui form inline team-add-member" data-api="/api/v1/teams/{{.Team.ID}}/members"><div class="ui input member-search-box"><span class="ui input search-clear-field" data-search-clear="input"><input type="search" name="Username" data-member-search aria-expanded="false" placeholder="搜索用户…" aria-label="添加团队成员" autocomplete="off" required>{{template "shared/search_clear" .}}</span><div class="member-suggestions" data-member-suggestions hidden>{{range .TeamCandidates}}<button type="button" class="member-suggestion" data-member-name="{{.Name}}" data-member-match="{{.Name}} {{.DisplayName}}">{{if $.IsOrgMember .ID}}<img loading="lazy" src="/avatars/users/{{.ID}}?org={{$.Org.ID}}&amp;size=48" width="24" height="24" alt="">{{else}}{{template "shared/menu_icon" "person"}}{{end}}<span>{{.Name}}{{if .DisplayName}} <span class="muted">{{.DisplayName}}</span>{{end}}</span></button>{{end}}<span data-member-empty hidden>没有匹配的用户</span></div></div><button class="ui primary button">添加团队成员</button></form><p class="muted">添加已有启用账号；用户将自动加入组织。</p></div>{{end}}
 <form class="ui form org-search" method="get"><div class="ui fluid action input"><span class="ui input search-clear-field" data-search-clear="submit"><input type="search" name="q" value="{{.Search}}" placeholder="搜索团队成员…" aria-label="搜索团队成员">{{template "shared/search_clear" .}}</span><button class="ui icon button" aria-label="搜索">{{template "shared/menu_icon" "search"}}</button></div></form>
 <div class="ui segment">{{range .FilteredTeamMembers}}<div class="org-member-item">{{if $.CanViewUserProfile .UserID}}<a href="/user/profile?user_id={{.UserID}}"><img loading="lazy" class="avatar" src="/avatars/users/{{.UserID}}?org={{$.Org.ID}}&amp;size=64" width="32" height="32" alt=""></a>{{else}}<img loading="lazy" class="avatar" src="/avatars/users/{{.UserID}}?org={{$.Org.ID}}&amp;size=64" width="32" height="32" alt="">{{end}}<strong class="org-member-main">{{if $.CanViewUserProfile .UserID}}<a href="/user/profile?user_id={{.UserID}}">{{$.Username .UserID}}</a>{{else}}{{$.Username .UserID}}{{end}}{{with $.UserDisplayName .UserID}}（{{.}}）{{end}}</strong>{{if $.Org.CanManage}}<form data-member-remove="确认将 {{$.Username .UserID}} 从团队 {{$.Team.Name}} 移除？离开最后一个团队时也会离开组织。" data-api="/api/v1/teams/{{$.Team.ID}}/members"><input type="hidden" name="UserID" data-number value="{{.UserID}}"><input type="hidden" name="Remove" data-bool value="true"><button class="ui basic red button action-small" {{if and $.Team.IsOwnerTeam (eq (len $.TeamMembers) 1)}}disabled title="至少保留一位 Owners 成员"{{end}}>移除成员</button></form>{{end}}{{if and $.Org.CanManage (and $.Team.IsOwnerTeam (eq (len $.TeamMembers) 1))}}<p class="help restriction-hint org-member-restriction">{{template "shared/menu_icon" "info"}}此成员是 Owners 的最后一位成员，不能移除。</p>{{end}}</div>{{else}}<p>没有匹配的成员。</p>{{end}}</div>
</section></div>
