{{/* Adapted from Gitea templates/org/team/sidebar.tmpl (MIT). */}}
<aside class="team-detail-sidebar"><h3 class="ui top attached header">{{.Team.Name}} <span class="ui mini label">{{if .Team.IsOwnerTeam}}内置{{else}}组织内{{end}}</span></h3><div class="ui attached segment">{{if .Team.IsOwnerTeam}}<p class="restriction-hint">{{template "shared/menu_icon" "info"}}Owners 拥有组织和全部仓库的管理权限，至少保留一位成员。</p>{{else}}<p>{{.Team.Description}}</p><p class="muted restriction-hint">{{template "shared/menu_icon" "info"}}仅可浏览指定仓库。</p>{{end}}<p>{{len .TeamMembers}} 名成员</p><a href="{{.OrgSection "teams"}}">返回团队列表</a></div></aside>
