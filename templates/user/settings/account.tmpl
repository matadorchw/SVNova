{{/* Adapted from Gitea templates/user/settings/account.tmpl (MIT); local credentials only. */}}
<div class="flex-container user settings account">
 {{template "user/settings/navbar" .}}
 <div class="flex-container-main user-setting-content">
  <h4 class="ui top attached header">修改密码</h4>
  <div class="ui attached segment">
  {{if .User.LDAPAccount}}<div class="ui info message restriction-hint">{{template "shared/menu_icon" "info"}}LDAP 账号的密码由目录服务管理，请在目录服务中修改。</div>{{else}}
   <form class="ui form" data-api="/api/v1/user/password" data-next="/user/login?password_changed=1">
    <div class="required field"><label for="old_password">当前密码</label><input id="old_password" name="CurrentPassword" type="password" autocomplete="current-password" required maxlength="1024" autofocus></div>
    <div class="required field"><label for="password">新的密码</label><input id="password" name="NewPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="1024"><p class="muted">至少 12 字节。修改后所有设备的登录会话将失效，需要重新登录。</p></div>
    <div class="required field"><label for="retype">确认新密码</label><input id="retype" name="ConfirmPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="1024"></div>
    <button class="ui primary button">更新密码</button>
   </form>
  {{end}}
  </div>
 </div>
</div>
