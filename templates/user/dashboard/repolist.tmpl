{{/* Adapted from Gitea templates/user/dashboard/repolist.tmpl (MIT). */}}
<aside class="dashboard-sidebar">
 <nav class="ui two item menu dashboard-switch" aria-label="侧栏切换"><a class="item {{if eq .DashboardView "repositories"}}active{{end}}" href="{{.DashboardURL "view" "repositories" "q" "" "repo_page" ""}}">仓库</a><a class="item {{if eq .DashboardView "organizations"}}active{{end}}" href="{{.DashboardURL "view" "organizations" "q" "" "repo_page" ""}}">组织</a></nav>
 <h4 class="ui top attached header dashboard-repo-header"><span>{{if eq .DashboardView "repositories"}}仓库列表 <span class="ui tiny label">{{.RepoTotal}}</span>{{else}}组织列表 <span class="ui tiny label">{{len .Organizations}}</span>{{end}}</span>{{if eq .DashboardView "repositories"}}{{if .CanMigrate}}<a href="/repo/migrate" aria-label="迁移仓库">{{template "shared/menu_icon" "plus"}}</a>{{end}}{{else}}{{if .User.Admin}}<a href="/org/create" aria-label="创建组织">{{template "shared/menu_icon" "plus"}}</a>{{end}}{{end}}</h4>
 <div class="ui attached segment dashboard-search"><form class="ui form" method="get"><input type="hidden" name="org" value="{{.ContextOrg}}"><input type="hidden" name="view" value="{{.DashboardView}}"><input type="hidden" name="kind" value="{{.KindFilter}}">{{if .DateFilter}}<input type="hidden" name="date" value="{{.DateFilter}}">{{end}}<div class="ui fluid action input"><span class="ui input search-clear-field" data-search-clear="submit"><input type="search" name="q" value="{{.Search}}" placeholder="{{if eq .DashboardView "repositories"}}搜索仓库…{{else}}搜索组织…{{end}}" aria-label="搜索侧栏">{{template "shared/search_clear" .}}</span><button class="ui icon button" aria-label="搜索">{{template "shared/menu_icon" "search"}}</button></div></form></div>
 {{if eq .DashboardView "repositories"}}
 <nav class="ui attached secondary pointing tabular borderless menu dashboard-kind-filter" aria-label="仓库类型"><a class="item {{if eq .KindFilter "all"}}active{{end}}" href="{{.DashboardURL "kind" "all" "repo_page" ""}}">全部{{if eq .KindFilter "all"}}<span class="ui circular mini grey label">{{.RepoMatchTotal}}</span>{{end}}</a><a class="item {{if eq .KindFilter "local"}}active{{end}}" href="{{.DashboardURL "kind" "local" "repo_page" ""}}">本地{{if eq .KindFilter "local"}}<span class="ui circular mini grey label">{{.RepoMatchTotal}}</span>{{end}}</a><a class="item {{if eq .KindFilter "mirror"}}active{{end}}" href="{{.DashboardURL "kind" "mirror" "repo_page" ""}}">镜像{{if eq .KindFilter "mirror"}}<span class="ui circular mini grey label">{{.RepoMatchTotal}}</span>{{end}}</a></nav>
 <div class="ui attached segment dashboard-rows">{{range .Repositories}}<a class="dashboard-repo-row" href="{{repoLink .Organization .Name .ID}}">{{template "shared/menu_icon" "lock"}}<span>{{.Organization}}/{{.Name}}</span>{{template "repo/size" .Repository}}{{if or .Halted (eq .Status "failed")}}<span class="danger" title="仓库状态异常">{{template "shared/menu_icon" "alert"}}</span>{{else if and (eq .Status "ready") .LastSuccess}}<span class="dashboard-success" title="最近迁移或同步成功">{{template "shared/menu_icon" "check"}}</span>{{end}}</a>{{else}}<p class="empty">没有匹配的仓库。</p>{{end}}</div>
 {{template "shared/pagination" .RepositoryPagination.CompactView}}
 {{else}}<div class="ui attached segment dashboard-rows">{{range .SidebarOrgs}}<a class="dashboard-repo-row" href="{{orgLink .Name}}"><img loading="lazy" class="avatar" src="/avatars/organizations/{{.ID}}?size=48" width="24" height="24" alt=""><span>{{.DisplayName}}</span></a>{{else}}<p class="empty">没有匹配的组织。</p>{{end}}</div>{{end}}
</aside>
